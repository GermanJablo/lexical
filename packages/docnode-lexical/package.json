{
  "name": "@lexical/docnode",
  "description": "This package contains the functionality for integrating Lexical with DocNode.",
  "keywords": [
    "lexical",
    "editor",
    "rich-text",
    "docnode"
  ],
  "license": "MIT",
  "version": "0.38.2",
  "main": "dist/LexicalDocnode.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "docnode": "0.1.1",
    "lexical": "0.38.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facebook/lexical",
    "directory": "packages/docnode-lexical"
  },
  "module": "dist/LexicalDocnode.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/LexicalDocnode.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/LexicalDocnode.js"
      }
    }
  }
}
